{
  "name": "camellia-portal",
  "main": "./worker.js",
  "compatibility_date": "2026-08-25",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camellia-portal-db",
      "database_id": "72cd4692-ff11-476a-b9cd-8b4db42d5c81"
    }
  ],

 "observability": {
  "enabled": true
}

// Cloudflare deployment config
}